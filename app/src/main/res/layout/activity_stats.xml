<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115">

    <!-- Заголовок -->
    <TextView
        android:id="@+id/statsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="История оплат"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#E7EAF0"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- История -->
    <ScrollView
        android:id="@+id/historyScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/statsTitle"
        app:layout_constraintBottom_toTopOf="@id/statsSummaryContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"/>
    </ScrollView>

    <!-- Нижний блок статистики (тёмный фон, без новых drawable) -->
    <LinearLayout
        android:id="@+id/statsSummaryContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#1C1F26"
        android:elevation="4dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/nav_bar_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/mostExpensiveSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💎 Самая дорогая подписка: —"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#E7EAF0"/>

        <TextView
            android:id="@+id/monthlyCost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 Стоимость за месяц: —"
            android:textSize="15sp"
            android:textColor="#E7EAF0"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/avgCost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 Средняя подписка: —"
            android:textSize="15sp"
            android:textColor="#E7EAF0"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/totalSubscriptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📦 Количество подписок: —"
            android:textSize="15sp"
            android:textColor="#E7EAF0"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <!-- Нижняя навигация (НЕ ТРОГАЮ) -->
    <LinearLayout
        android:id="@+id/nav_bar_container"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="4"
        android:background="@drawable/rectangle"
        android:elevation="8dp"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/home"
            android:contentDescription="Дом"/>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent">

            <ImageView
                android:id="@+id/nav_stats"
                android:layout_width="55dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:contentDescription="Статистика"
                android:scaleType="centerCrop"
                android:src="@drawable/history" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent">

            <ImageView
                android:id="@+id/nav_add"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:contentDescription="Добавить подписку"
                android:scaleType="centerCrop"
                android:src="@drawable/plus" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent">

            <ImageView
                android:id="@+id/nav_settings"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_gravity="center"
                android:contentDescription="Настройки"
                android:scaleType="centerCrop"
                android:src="@drawable/settings" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/familyDialogRoot"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="#1C1F26"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Заголовок -->
    <TextView
        android:id="@+id/familyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Информация о семье"
        android:textAlignment="center"
        android:textColor="#E7EAF0"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="14dp" />

    <!-- Текущий пользователь -->
    <LinearLayout
        android:id="@+id/currentUserRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="14dp"
        android:background="#2A2D34">

        <androidx.cardview.widget.CardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="false">

            <ImageView
                android:id="@+id/currentUserAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="avatar"
                android:scaleType="centerCrop"
                android:src="@drawable/avatar_placeholder" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/currentUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#E7EAF0"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/currentUserRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#9AA0AA"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Название семьи -->
    <TextView
        android:id="@+id/familyName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Семья: —"
        android:textColor="#E7EAF0"
        android:textSize="18sp"
        android:layout_marginBottom="10dp" />

    <!-- Код семьи -->
    <TextView
        android:id="@+id/familyCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Код семьи: —"
        android:textColor="#E7EAF0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Нажми, чтобы скопировать и поделиться"
        android:textColor="#9AA0AA"
        android:textSize="12sp"
        android:layout_marginBottom="14dp" />

    <!-- Заголовок участников -->
    <TextView
        android:id="@+id/familyMembersLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Участники"
        android:textColor="#E7EAF0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Контейнер участников -->
    <LinearLayout
        android:id="@+id/familyMembersContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="14dp" />

    <!-- Кнопка закрыть -->
    <Button
        android:id="@+id/btnCloseDialog"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Закрыть"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#3A3F4B" />

</LinearLayout>

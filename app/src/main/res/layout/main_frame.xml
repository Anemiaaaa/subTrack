<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="ExtraText">

    <ImageButton
        android:id="@+id/btnFamilyInfo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="62dp"
        android:layout_marginEnd="40dp"
        android:background="@android:color/transparent"
        android:src="@drawable/info"
        tools:ignore="ExtraText" />

    <TextView
        android:id="@+id/textUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="60dp"
        android:text="Привет, Амир"
        android:textColor="#000000"
        android:textSize="25sp"
        android:textStyle="bold" />

    <!-- Центрированный контейнер подписок -->
    <FrameLayout
        android:id="@+id/subRestangle"
        android:layout_width="368dp"
        android:layout_height="500dp"
        android:layout_centerInParent="true"
        android:background="@drawable/subrestangle">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/subscriptionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:divider="?android:attr/dividerVertical"
                android:orientation="vertical"
                android:showDividers="middle" />
        </ScrollView>
    </FrameLayout>

    <!-- Нижняя панель -->
    <RelativeLayout
        android:id="@+id/nav_bar_container"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/rectangle"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="4"
            android:padding="12dp">

            <ImageButton
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:src="@drawable/home"
                android:contentDescription="Дом" />

            <ImageButton
                android:id="@+id/nav_calendar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:src="@drawable/calendar"
                android:contentDescription="Календарь" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent">

                <ImageView
                    android:id="@+id/nav_stats"
                    android:layout_width="71dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:contentDescription="Статистика"
                    android:scaleType="centerCrop"
                    android:src="@drawable/grafic" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/nav_add"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:src="@drawable/plus"
                android:contentDescription="Добавить подписку" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="ExtraText">

    <!-- Кнопка инфо семьи -->
    <ImageButton
        android:id="@+id/btnFamilyInfo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="62dp"
        android:layout_marginEnd="40dp"
        android:background="@android:color/transparent"
        android:src="@drawable/info" />

    <!-- Приветствие -->
    <TextView
        android:id="@+id/textUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="60dp"
        android:text="Привет, Амир"
        android:textColor="#000000"
        android:textSize="25sp"
        android:textStyle="bold" />

    <!-- Блок фильтров -->
    <LinearLayout
        android:id="@+id/filterSortContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/textUsername"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:weightSum="3">


        <!-- xml -->
        <TextView
            android:id="@+id/btnSortPrice"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Цена"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/chip_bg"
            android:padding="8dp"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/btnSortDate"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/chip_bg"
            android:gravity="center"
            android:padding="8dp"
            android:text="Дата"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/btnFilterUsers"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Семья"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/chip_bg"
            android:padding="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />


    </LinearLayout>

    <!-- Контейнер подписок — ОПУЩЕН НИЖЕ, чтобы ничего не перекрывал -->
    <FrameLayout
        android:id="@+id/subRestangle"
        android:layout_width="368dp"
        android:layout_height="490dp"
        android:layout_below="@id/filterSortContainer"
        android:layout_marginTop="12dp"
        android:layout_centerHorizontal="true"
        android:background="@drawable/subrestangle_dark">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/subscriptionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:divider="?android:attr/dividerVertical"
                android:orientation="vertical"
                android:showDividers="middle" />
        </ScrollView>
    </FrameLayout>


    <!-- Нижняя панель -->
    <RelativeLayout
        android:id="@+id/nav_bar_container"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/rectangle"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="4"
            android:padding="12dp">

            <ImageButton
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:src="@drawable/home"
                android:contentDescription="Дом" />

            <ImageButton
                android:id="@+id/nav_calendar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:src="@drawable/calendar"
                android:contentDescription="Календарь" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent">

                <ImageView
                    android:id="@+id/nav_stats"
                    android:layout_width="71dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:src="@drawable/grafic"
                    android:contentDescription="Статистика"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/nav_add"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:src="@drawable/plus"
                android:contentDescription="Добавить подписку" />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>

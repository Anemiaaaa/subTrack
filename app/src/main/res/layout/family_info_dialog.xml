<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_gravity="center"
    android:background="@drawable/dialog_bg">

    <!-- Заголовок -->
    <TextView
        android:id="@+id/familyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Информация о семье"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textSize="25sp"
        android:textColor="#000000"
        android:layout_marginBottom="30dp" />

    <!-- Название семьи -->
    <TextView
        android:id="@+id/familyName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Семья: —"
        android:textSize="22sp"
        android:textColor="#000000"
        android:layout_marginBottom="20dp" />

    <!-- Код семьи с надписью "поделиться" -->
    <TextView
        android:id="@+id/familyCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Код семьи: — "
        android:textSize="22sp"
        android:textColor="#000000"
        android:layout_marginBottom="1dp" />

    <!-- Код семьи с надписью "поделиться" -->
    <TextView
        android:id="@+id/share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="(нажми чтобы поделиться)"
        android:textSize="12sp"
        android:textColor="#000000"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />


    <!-- Заголовок участников -->
    <TextView
        android:id="@+id/familyMembersLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Участники:"
        android:textSize="22sp"
        android:textColor="#000000"
        android:layout_marginBottom="8dp" />

    <!-- Контейнер участников -->
    <LinearLayout
        android:id="@+id/familyMembersContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp" />

    <!-- Роль пользователя -->
    <TextView
        android:id="@+id/familyRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Роль: —"
        android:textSize="22sp"
        android:textColor="#000000"
        android:layout_marginBottom="24dp" />

    <!-- Кнопка выхода -->
    <Button
        android:id="@+id/leaveFamilyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Покинуть семью"
        android:textStyle="bold"
        android:backgroundTint="#FF4C4C"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:textSize="16sp" />

    <Button
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Выйти из аккаунта"
        android:textStyle="bold"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:textSize="16sp"
        android:layout_marginTop="8dp"/>


    <Button
        android:id="@+id/btnCloseDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Закрыть"
        android:backgroundTint="#B4AFAF"
        android:layout_marginTop="8dp" />


</LinearLayout>

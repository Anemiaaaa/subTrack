<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/dialog_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Редактирование"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/editTextServiceSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Поиск сервиса"
        android:saveEnabled="false"
        android:importantForAutofill="no"
        android:inputType="text"
        android:textColor="#000000"
        android:layout_marginBottom="10dp"/>

    <!-- Ряд: превью иконки + выбор сервиса -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/serviceIconPreview"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="service_icon_preview"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_default"
            android:layout_marginEnd="12dp" />

        <Spinner
            android:id="@+id/spinnerService"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <EditText
        android:id="@+id/editTextName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Название"
        android:textColor="#000000"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/editTextPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Цена"
        android:inputType="numberDecimal"
        android:textColor="#000000"
        android:layout_marginBottom="10dp"/>

    <Spinner
        android:id="@+id/spinnerPeriodicity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/periodicity_options"
        android:layout_marginBottom="14dp"/>

    <Button
        android:id="@+id/buttonSave"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Сохранить"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1F1F1F"/>
</LinearLayout>

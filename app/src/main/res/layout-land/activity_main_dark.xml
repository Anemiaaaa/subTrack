<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1114"
    android:padding="32dp">

    <!-- Контейнер для центрирования контента -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Левая часть: Логотип и заголовок -->
    <androidx.cardview.widget.CardView
        android:id="@+id/headerCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#1C1F26"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline_center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/icon"
                android:background="@drawable/circle_bg"
                android:padding="20dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/textViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jura_semibold"
                android:text="SubTrack"
                android:textColor="#E7EAF0"
                android:textSize="36sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Управление подписками"
                android:textColor="#9AA0AA"
                android:textSize="16sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Правая часть: Форма входа -->
    <androidx.cardview.widget.CardView
        android:id="@+id/inputCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#1C1F26"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline_center"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeWidth="0dp"
                app:boxBackgroundMode="outline"
                app:hintTextColor="#9AA0AA"
                app:boxStrokeColor="#2A2D34"
                app:boxBackgroundColor="#2A2D34">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Имя пользователя"
                    android:inputType="text"
                    android:textSize="16sp"
                    android:textColor="#E7EAF0"
                    android:fontFamily="@font/jura_semibold"
                    android:padding="16dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeWidth="0dp"
                app:boxBackgroundMode="outline"
                app:hintTextColor="#9AA0AA"
                app:boxStrokeColor="#2A2D34"
                app:boxBackgroundColor="#2A2D34">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Код семьи"
                    android:inputType="text"
                    android:textSize="16sp"
                    android:textColor="#E7EAF0"
                    android:fontFamily="@font/jura_semibold"
                    android:padding="16dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="Войти по имени"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/jura_semibold"
                app:cornerRadius="16dp"
                app:backgroundTint="#E7EAF0"
                android:textColor="#0F1114"
                app:elevation="2dp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/googleLoginButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#2A2D34"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imageGoogleIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Google Icon"
                        android:src="@drawable/ic_google"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/textGoogleLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jura_semibold"
                        android:text="Войти через Google"
                        android:textAllCaps="false"
                        android:textColor="#E7EAF0"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/textGuestLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Войти как гость"
                    android:textColor="#E7EAF0"
                    android:textSize="14sp"
                    android:fontFamily="@font/jura_semibold"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/textForgotFamilyCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Забыли код семьи?"
                    android:textColor="#9AA0AA"
                    android:textSize="14sp"
                    android:fontFamily="@font/jura_semibold"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/textNoAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Нет аккаунта?"
                    android:textColor="#9AA0AA"
                    android:textSize="14sp"
                    android:fontFamily="@font/jura_semibold"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/buttonCreateFamily"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Создать"
                    android:textColor="#E7EAF0"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:fontFamily="@font/jura_semibold"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="8dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>


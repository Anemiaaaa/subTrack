<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Нижний слой: тень (слабый градиент) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33000000"/> <!-- полупрозрачная тень -->
            <corners android:radius="16dp"/>
        </shape>
    </item>

    <!-- Верхний слой: основной фон -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/> <!-- основной фон -->
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#EEEEEE"/> <!-- лёгкая рамка -->
        </shape>
    </item>

</layer-list>
